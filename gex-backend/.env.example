# --- Veritabanı ---
DATABASE_URL=postgresql://gex_user:changeme@localhost:5432/gex_db
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5433/gex_test

# --- Kimlik Doğrulama ---
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER_ME=30
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Veri Kaynağı ---
MARKET_DATA_PROVIDER=yfinance          # yfinance | tradier | polygon
TRADIER_API_KEY=                        # yalnızca provider=tradier ise gerekli
POLYGON_API_KEY=                        # yalnızca provider=polygon ise gerekli
REQUEST_DELAY_SECONDS=1.0
MAX_FETCH_RETRIES=3
FETCH_RETRY_BACKOFF_SECONDS=5

# --- Hesaplama Parametreleri (Bölüm 3) ---
RISK_FREE_RATE=0.05
CONTRACT_MULTIPLIER=100
GEX_MOVE_PCT=0.01
NEUTRAL_BAND_PCT=0.002
DEALER_SIGN_CONVENTION=standard

# --- Zamanlanmış İşler ---
FETCH_INTERVAL_MINUTES=2
ALERT_COOLDOWN_MINUTES=30
CLEANUP_HOUR_ET=3

# --- Veri Saklama (Bölüm 5.15) ---
RAW_DATA_RETENTION_DAYS=90
STRIKE_GEX_RETENTION_DAYS=365
PRICE_SNAPSHOT_RETENTION_DAYS=365
READ_NOTIFICATION_RETENTION_DAYS=180

# --- E-posta (Bölüm 12.5) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@gex-platform.example

# --- Genel ---
ENVIRONMENT=development                 # development | staging | production
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173
GAMMA_FLIP_SELECTION=nearest_spot
GAMMA_FLIP_METHOD=zero_gamma
ENABLE_SCHEDULER=false                  # uretimde true
FETCH_MAX_WORKERS=6                     # paralel cekim; yukseltmek 429 riskini artirir
SCAN_ENABLED=false                      # genis evren taramasi (yalnizca ozet)
SCAN_INTERVAL_MINUTES=30
EOD_SNAPSHOT_ENABLED=true               # gunluk kapanis anlik goruntusu (edge dogrulama veri seti)
EOD_SNAPSHOT_HOUR_ET=17
